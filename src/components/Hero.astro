---
import { getImage } from "astro:assets"
import heroMobileImage from "~/assets/images/hero-mobile.webp"
import heroImage from "~/assets/images/hero.webp"
import Button from "./ui/Button.astro"

const hero = await getImage({ src: heroImage, format: "webp", width: 2400 })
const heroMobile = await getImage({
	src: heroMobileImage,
	format: "webp",
	width: 1200,
})
---

<header
	id="hero"
	class="relative grid min-h-svh place-items-center"
	tabindex="-1"
>
	<picture class="absolute inset-0">
		<source media="(min-width: 768px)" srcset={hero.src} />
		<img
			src={heroMobile.src}
			alt=""
			width={heroMobile.options.width}
			height={heroMobile.options.height}
			fetchpriority="high"
			class="size-full object-cover"
		/>
	</picture>
	<div class="relative grid place-items-center gap-4">
		<h1 class="px-4 text-5xl font-semibold text-white md:text-7xl">
			Anna Visuals
		</h1>
		<Button
			class="rounded-md bg-black px-4 py-2 text-white shadow-md shadow-black/60"
			data-modal-open="contact-modal"
		>
			Skontaktuj się
		</Button>
	</div>
</header>
