---
import { Image } from "astro:assets"
import heroImage from "~/assets/images/hero.webp"
---

<header id="hero" class="relative grid min-h-svh place-items-center" tabindex="-1">
	<Image
		src={heroImage}
		alt=""
		loading="eager"
		fetchpriority="high"
		class="absolute inset-0 size-full object-cover"
	/>
	<h1 class="relative px-4 text-5xl font-semibold text-white drop-shadow-[0_3px_8px_rgba(0,0,0,0.55)] md:text-7xl">
		Anna Visuals
	</h1>
</header>
