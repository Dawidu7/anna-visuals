---
import { type HTMLAttributes } from "astro/types"
import { cn } from "~/lib/utils"
import Icon from "./ui/Icon.astro"

const variants = {
	instagram: "bg-linear-to-tr from-[#f58529] via-[#dd2a7b] to-[#515bd4] text-white",
	whatsapp: "bg-linear-to-tr from-[#128c7e] to-[#25D366] text-white",
	phone: "bg-linear-to-tr from-[#64c35f] to-[#87f082] text-white",
}

export type ContactVariant = keyof typeof variants

type Props = HTMLAttributes<"a"> & {
	href: string
	variant: ContactVariant
}

const { class: className, variant, ...props } = Astro.props
---

<a
	target={variant === "phone" ? undefined : "_blank"}
	rel={variant === "phone" ? undefined : "noopener noreferrer"}
	class={cn(
		"flex w-full items-center justify-between gap-2 rounded-md px-4 py-3 shadow-md",
		variants[variant],
		className,
	)}
	{...props}
>
	<slot />
	{variant === "phone" ? (
		<Icon name="phone" class="size-5" fill="currentColor" />
	) : (
		<Icon name="arrow-top-right" class="size-5" />
	)}
</a>
