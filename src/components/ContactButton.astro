---
import { type HTMLAttributes } from "astro/types"
import { cn } from "~/lib/utils"

const variants = {
	instagram:
		"bg-linear-to-tr from-[#f58529] via-[#dd2a7b] to-[#515bd4] text-white",
	whatsapp: "bg-linear-to-tr from-[#128c7e] to-[#25D366] text-white",
	phone: "bg-linear-to-tr from-[#64c35f] to-[#87f082] text-white",
}

export type ContactVariant = keyof typeof variants

type Props = HTMLAttributes<"a"> & {
	href: string
	variant: ContactVariant
}

const { class: className, variant, ...props } = Astro.props
---

<a
	target={variant === "phone" ? undefined : "_blank"}
	rel={variant === "phone" ? undefined : "noopener noreferrer"}
	class={cn(
		"flex w-full items-center justify-between gap-2 rounded-md px-4 py-3 shadow-md",
		variants[variant],
		className,
	)}
	{...props}
>
	<slot />
	{variant === "phone" ? (
		<svg
			viewBox="0 0 24 24"
			class="size-5"
			fill="currentColor"
			aria-hidden="true"
		>
			<path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.56 3.58.56a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.19 2.46.56 3.58a1 1 0 01-.25 1.01l-2.19 2.2z" />
		</svg>
	) : (
		<svg
			viewBox="0 0 24 24"
			class="size-5"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M7 17 17 7M8 7h9v9" />
		</svg>
	)}
</a>
