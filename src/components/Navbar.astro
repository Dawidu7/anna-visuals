---
import ContactButton from "./ContactButton.astro"
import Button from "./ui/Button.astro"
import Modal from "./ui/Modal.astro"

const items: { href: string; text: string }[] = [
	{ href: "#gallery", text: "Zdjęcia" },
	{ href: "#services", text: "Serwisy" },
	{ href: "#about", text: "O mnie" },
]

const liClass =
	"w-fit max-sm:opacity-0 max-sm:translate-y-4 max-sm:transition-all max-sm:duration-500 max-sm:ease-out max-sm:group-data-[open=true]:translate-y-0 max-sm:group-data-[open=true]:opacity-100"
---

<nav
	class="group sticky top-0 z-50 w-full bg-white px-8 py-4"
	data-open="false"
>
	<div class="mx-auto flex max-w-6xl items-center justify-between">
		<a href="#hero" class="text-xl font-semibold">
			Anna Visuals
		</a>
		<Button class="sm:hidden" data-nav-open>
			<svg
				class="size-6"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</Button>
		<ul class="flex gap-12 max-sm:pointer-events-none max-sm:invisible max-sm:fixed max-sm:inset-0 max-sm:flex-col max-sm:items-end max-sm:bg-black/50 max-sm:px-10 max-sm:py-8 max-sm:text-4xl max-sm:font-semibold max-sm:text-white max-sm:opacity-0 max-sm:backdrop-blur-md max-sm:transition-opacity max-sm:duration-500 max-sm:group-data-[open=true]:pointer-events-auto max-sm:group-data-[open=true]:visible max-sm:group-data-[open=true]:opacity-100 sm:justify-center md:gap-20">
			<li class={`sm:hidden ${liClass}`}>
				<Button data-nav-close>
					<svg
						class="size-12"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						aria-hidden="true"
					>
						<path d="M6 6l12 12M18 6L6 18" />
					</svg>
				</Button>
			</li>
			{items.map(({ href, text }, i) => (
				<li class={liClass} style={`transition-delay: ${i * 100 + 100}ms`}>
					<a href={href}>{text}</a>
				</li>
			))}
			<li class={`sm:hidden ${liClass}`} style="transition-delay: 400ms">
				<Button data-modal-open="contact-modal">Kontakt</Button>
			</li>
		</ul>
		<Button
			class="justify-self-end rounded-md bg-black px-4 py-2 text-white max-sm:hidden"
			data-modal-open="contact-modal"
		>
			Kontakt
		</Button>
	</div>
</nav>

<script>
	const nav = document.querySelector("nav")!
	const closeMenu = () => {
		nav.dataset.open = "false"
		document.body.style.overflow = ""
	}

	nav
		.querySelector<HTMLButtonElement>("[data-nav-open]")
		?.addEventListener("click", () => {
			nav.dataset.open = "true"
			document.body.style.overflow = "hidden"
		})
	nav
		.querySelector<HTMLButtonElement>("[data-nav-close]")
		?.addEventListener("click", closeMenu)

	nav.querySelectorAll("a").forEach(link => {
		link.addEventListener("click", e => {
			e.preventDefault()
			closeMenu()
			document.querySelector(link.hash)?.scrollIntoView({ behavior: "smooth" })
		})
	})

	document.addEventListener("keydown", e => {
		if (e.key === "Escape") closeMenu()
	})

	const menu = nav.querySelector("ul")!
	menu.addEventListener("click", e => {
		if (e.target === menu) closeMenu()
	})

	nav
		.querySelector<HTMLButtonElement>("[data-modal-open]")
		?.addEventListener("click", () => {
			if (nav.dataset.open === "false") return
			closeMenu()
		})
</script>
