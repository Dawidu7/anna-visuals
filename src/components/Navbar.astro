---
import Button from "./ui/Button.astro"

const dropdownItems: { href: string; label: string }[] = [
	{ href: "#fashion", label: "Fotografia Modowa" },
	{ href: "#portrait", label: "Portret & Sensual" },
	{ href: "#branding", label: "Fotografia Wizerunkowa" },
	{ href: "#couples", label: "Dla Par" },
	{ href: "#artistic", label: "Fotografia Artystyczna" },
]
---

<nav
	class="group sticky top-0 z-50 bg-white px-4 py-4"
	data-dropdown-open="false"
	data-menu-open="false"
>
	<div class="mx-auto flex max-w-5xl items-center justify-between">
		<a href="#hero" class="text-lg font-semibold">
			Anna Visuals
		</a>
		<Button class="sm:hidden" data-menu-trigger>
			<svg
				class="size-6"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
			>
				<path d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</Button>
		<ul class="hidden gap-8 group-data-[menu-open=true]:flex max-sm:fixed max-sm:inset-0 max-sm:flex-col max-sm:items-end max-sm:gap-12 max-sm:bg-black/50 max-sm:px-12 max-sm:py-10 max-sm:text-5xl max-sm:font-semibold max-sm:text-white max-sm:backdrop-blur-md sm:flex">
			<li class="sm:hidden">
				<Button data-menu-close>
					<svg
						class="size-12"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						aria-hidden="true"
					>
						<path d="M6 6l12 12M18 6L6 18" />
					</svg>
				</Button>
			</li>
			<li>
				<a href="#about">O mnie</a>
			</li>
			<li>
				<a href="#gallery">Portfolio</a>
			</li>
			<li class="relative">
				<Button class="ml-auto flex items-center gap-2" data-dropdown-trigger>
					Oferta
					<svg
						class="size-12 transition-transform group-data-[dropdown-open=true]:rotate-180 sm:size-4"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="m6 9 6 6 6-6" />
					</svg>
				</Button>
				<div class="invisible right-0 mt-2 grid w-max grid-rows-[0fr] transition-[grid-template-rows,visibility] duration-300 ease-in-out group-data-[dropdown-open=true]:visible group-data-[dropdown-open=true]:grid-rows-[1fr] sm:absolute sm:rounded-md sm:shadow-lg">
					<div class="overflow-hidden sm:rounded-md">
						<ul
							class="text-nowrap max-sm:text-right max-sm:text-2xl sm:bg-white"
							data-dropdown-menu
						>
							{dropdownItems.map(({ href, label }) => (
								<li>
									<a
										href={href}
										class="block rounded px-3 py-1.5 hover:bg-black/10"
									>
										{label}
									</a>
								</li>
							))}
						</ul>
					</div>
				</div>
			</li>
			<li>
				<a href="#contact">Kontakt</a>
			</li>
		</ul>
	</div>
</nav>

<script>
	const nav = document.querySelector("nav")!

	nav.addEventListener("click", e => {
		const target = e.target as HTMLElement

		if (target.closest("[data-dropdown-trigger]")) {
			nav.dataset.dropdownOpen = String(nav.dataset.dropdownOpen === "false")
		}

		if (target.closest("[data-menu-trigger]")) {
			nav.dataset.menuOpen = "true"
		}

		if (target.closest("[data-menu-close], a")) {
			nav.dataset.menuOpen = "false"
			nav.dataset.dropdownOpen = "false"
		}
	})

	document.addEventListener("click", e => {
		const target = e.target as HTMLElement

		if (
			nav.dataset.dropdownOpen === "true" &&
			!target.closest("[data-dropdown-menu]") &&
			!target.closest("[data-dropdown-trigger]")
		) {
			nav.dataset.dropdownOpen = "false"
		}
	})
</script>
