---
import Button from "./ui/Button.astro"

const dropdownItems: { href: string; label: string }[] = [
	{ href: "#fashion", label: "Fotografia Modowa" },
	{ href: "#portrait", label: "Portret & Sensual" },
	{ href: "#branding", label: "Fotografia Wizerunkowa" },
	{ href: "#couples", label: "Dla Par" },
	{ href: "#artistic", label: "Fotografia Artystyczna" },
]
---

<nav
	class="group sticky top-0 z-50 bg-white px-4 py-4"
	data-dropdown-open="false"
>
	<div class="mx-auto flex max-w-5xl items-center justify-between">
		<a href="#hero" class="text-lg font-semibold">
			Anna Visuals
		</a>
		<Button class="sm:hidden">
			<svg
				class="size-6"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
			>
				<path d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</Button>
		<ul class="flex gap-8">
			<li>
				<a href="#about">O mnie</a>
			</li>
			<li>
				<a href="#gallery">Portfolio</a>
			</li>
			<li class="relative">
				<Button class="flex items-center gap-2" data-dropdown-trigger>
					Oferta
					<svg
						class="size-4 transition-transform group-data-[dropdown-open=true]:rotate-180"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="m6 9 6 6 6-6" />
					</svg>
				</Button>
				<div class="invisible absolute right-0 mt-2 grid w-max grid-rows-[0fr] rounded-md shadow-lg transition-[grid-template-rows,visibility] duration-300 ease-in-out group-data-[dropdown-open=true]:visible group-data-[dropdown-open=true]:grid-rows-[1fr]">
					<div class="overflow-hidden rounded-md">
						<ul class="bg-white text-nowrap" data-dropdown-menu>
							{dropdownItems.map(({ href, label }) => (
								<li>
									<a
										href={href}
										class="block rounded px-3 py-1.5 hover:bg-black/10"
									>
										{label}
									</a>
								</li>
							))}
						</ul>
					</div>
				</div>
			</li>
			<li>
				<a href="#contact">Kontakt</a>
			</li>
		</ul>
	</div>
</nav>

<script>
	const nav = document.querySelector("nav")!

	// Dropdown Trigger
	const dropdownTrigger = nav.querySelector<HTMLButtonElement>(
		"[data-dropdown-trigger]",
	)!
	dropdownTrigger.addEventListener("click", () => {
		nav.dataset.dropdownOpen = String(nav.dataset.dropdownOpen === "false")
	})

	// Dropdown Menu
	nav
		.querySelector<HTMLUListElement>("[data-dropdown-menu]")!
		.addEventListener("click", e => {
			if ((e.target as HTMLElement).closest("a")) {
				nav.dataset.dropdownOpen = "false"
			}
		})
</script>
