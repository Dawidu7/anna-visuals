---
import { Image } from "astro:assets"
import { type Service } from "~/lib/types"

type Props = Service

const { title, text, image } = Astro.props
---

<li class="group px-6 py-8 odd:bg-[#eeeeee] even:bg-[#dddddd]">
	<div class="mx-auto max-w-4xl items-center gap-20 space-y-4 group-even:flex-row-reverse sm:flex">
		<div class="sm:w-1/2">
			{image ? (
				<Image src={image} alt="" />
			) : (
				<div class="aspect-3/4 w-full bg-black/20" />
			)}
		</div>
		<div class="flex flex-col gap-4 text-center sm:w-1/2 sm:text-left">
			<h3 class="text-2xl font-semibold uppercase">{title}</h3>
			<p>{text}</p>
		</div>
	</div>
</li>
