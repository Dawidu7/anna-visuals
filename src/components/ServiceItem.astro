---
import { type Service } from "~/lib/types"

type Props = Service

const { title, text } = Astro.props
---

<li class="group px-6 py-8 odd:bg-[#eeeeee] even:bg-[#dddddd]">
	<div class="mx-auto max-w-4xl items-center gap-20 group-even:flex-row-reverse md:flex">
		<div class="aspect-square bg-black md:w-1/2" />
		<div class="flex flex-col gap-4 text-center md:w-1/2 md:text-left">
			<h3 class="text-2xl font-semibold uppercase">{title}</h3>
			<p>{text}</p>
		</div>
	</div>
</li>
