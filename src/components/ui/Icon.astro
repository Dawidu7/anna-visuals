---
import type { HTMLAttributes } from "astro/types"

const icons = {
	chevron: "m6 9 6 6 6-6",
	close: "M6 6l12 12M18 6L6 18",
	hamburger: "M4 6h16M4 12h16M4 18h16",
	phone:
		"M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.56 3.58.56a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.19 2.46.56 3.58a1 1 0 01-.25 1.01l-2.19 2.2z",
	"arrow-top-right": "M7 17 17 7M8 7h9v9",
}

type Props = HTMLAttributes<"svg"> & { name: keyof typeof icons }

const { name, fill = "none", ...props } = Astro.props
---

<svg
	viewBox="0 0 24 24"
	fill={fill}
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	aria-hidden="true"
	{...props}
>
	<path d={icons[name]} />
</svg>
