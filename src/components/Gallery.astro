---
import { Image } from "astro:assets"
import Button from "./ui/Button.astro"
import Modal from "./ui/Modal.astro"

const images = Object.values(
	import.meta.glob<{ default: ImageMetadata }>(
		"../assets/images/gallery/*.jpg",
		{ eager: true },
	),
).map(({ default: src }) => ({
	src,
}))
---

<section
	id="gallery"
	class="group relative mx-auto max-h-[150dvh] max-w-5xl overflow-hidden px-4 pt-16 transition-[max-height] duration-500 ease-in-out data-[expanded=true]:pb-12"
	data-expanded="false"
>
	<ul class="columns-2 space-y-4 md:columns-3">
		{images.map(({ src }) => (
			<li class="overflow-hidden">
				<Button data-modal-open="image-modal">
					<Image
						src={src}
						alt=""
						loading="lazy"
						class="transition-[scale] hover:scale-105"
					/>
				</Button>
			</li>
		))}
	</ul>
	<div class="pointer-events-none absolute inset-x-0 bottom-0 grid h-48 place-items-center bg-linear-to-t from-white to-transparent group-data-[expanded=true]:opacity-0" />
	<Button class="absolute inset-x-0 bottom-3" data-collapse-button>
		Więcej &#x2193;
	</Button>
</section>

<Modal id="image-modal" variant="full">
	<img src="" alt="" class="max-h-[90dvh] max-w-[90dvw] object-contain" />
</Modal>

<script>
	const gallery = document.querySelector<HTMLElement>("#gallery")!
	const galleryCollapseButton = gallery.querySelector<HTMLButtonElement>(
		"[data-collapse-button]",
	)!

	const galleryCollapsedHeight = getComputedStyle(gallery).maxHeight

	galleryCollapseButton.addEventListener("click", () => {
		const isExpanded = !(gallery.dataset.expanded === "true")
		gallery.dataset.expanded = String(isExpanded)

		gallery.style.maxHeight = isExpanded
			? `${gallery.scrollHeight}px`
			: galleryCollapsedHeight

		galleryCollapseButton.innerHTML = isExpanded
			? "Mniej &#x2191;"
			: "Więcej &#x2193;"
	})

	const modalImg = document.querySelector<HTMLImageElement>("#image-modal img")!
	gallery
		.querySelectorAll<HTMLButtonElement>("[data-modal-open]")
		.forEach(button => {
			button.addEventListener("click", () => {
				const img = button.querySelector("img")!
				modalImg.src = img.src
				modalImg.alt = img.alt
			})
		})
</script>
