---
import { Image } from "astro:assets"
import Button from "./ui/Button.astro"

const images = Object.values(
	import.meta.glob<{ default: ImageMetadata }>(
		"../assets/images/gallery/*.jpg",
		{ eager: true },
	),
).map(({ default: src }) => ({
	src,
}))
---

<section
	id="gallery"
	class="group relative mx-auto max-w-5xl overflow-hidden px-4 pt-16 data-[expanded=true]:pb-12"
	style="max-height: 150dvh;"
	data-expanded="false"
>
	<ul class="columns-2 space-y-4 md:columns-3">
		{images.map(({ src }) => (
			<li class="overflow-hidden">
				<Button data-modal-trigger>
					<Image
						src={src}
						alt=""
						loading="lazy"
						class="cursor-pointer transition-[scale] hover:scale-105"
					/>
				</Button>
			</li>
		))}
	</ul>
	<div class="absolute inset-x-0 bottom-0 grid h-48 place-items-center bg-linear-to-t from-white to-transparent group-data-[expanded=true]:opacity-0" />
	<Button class="absolute inset-x-0 bottom-3" data-collapse-button>
		Więcej &#x2193;
	</Button>
</section>

<dialog class="m-auto backdrop:bg-black/80">
	<img src="" alt="" class="max-h-[90dvh] max-w-[90dvw] object-contain" />
	<Button class="absolute top-4 right-4 text-2xl text-white" data-close>
		&#x2715;
	</Button>
</dialog>

<script>
	const gallery = document.querySelector<HTMLElement>("#gallery")!
	const galleryCollapsedHeight = getComputedStyle(gallery).maxHeight
	const galleryCollapseButton = gallery.querySelector<HTMLButtonElement>(
		"[data-collapse-button]",
	)!

	galleryCollapseButton.addEventListener("click", () => {
		const isExpanded = !(gallery.dataset.expanded === "true")
		gallery.dataset.expanded = String(isExpanded)

		gallery.style.maxHeight = isExpanded
			? `${gallery.scrollHeight}px`
			: galleryCollapsedHeight

		galleryCollapseButton.innerHTML = isExpanded
			? "Mniej &#x2191;"
			: "Więcej &#x2193;"
	})
</script>

<script>
	const modal = document.querySelector("dialog")!

	document
		.querySelectorAll<HTMLButtonElement>("[data-modal-trigger]")!
		.forEach(button => {
			button.addEventListener("click", () => {
				modal.querySelector("img")!.src = button.querySelector("img")!.src
				modal.showModal()
			})
		})

	modal.addEventListener("click", e => {
		if (e.target === modal) modal.close()
	})

	modal
		.querySelector<HTMLButtonElement>("[data-close]")!
		.addEventListener("click", () => modal.close())
</script>
